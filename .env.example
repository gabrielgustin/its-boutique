# ───────────── Base de datos ─────────────
# Sin DATABASE_URL la app usa PGlite (Postgres embebido) y guarda en ./data: ideal para desarrollar.
# Con DATABASE_URL usa ese Postgres (Neon, Supabase, RDS…). Las migraciones de db/migrations
# se aplican solas en cada `npm run build`, o a mano con `npm run db:migrate`.
DATABASE_URL=

# ───────────── Inicio de sesión del backoffice (Better Auth) ─────────────
# Obligatorio en producción. Generar con: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Dirección pública del sitio, p. ej. https://tienda.midominio.com
BETTER_AUTH_URL=
NEXT_PUBLIC_SITE_URL=

# ───────────── Imágenes ─────────────
# Token de Vercel Blob. Sin él, las imágenes se guardan en ./data/uploads (solo sirve en local).
BLOB_READ_WRITE_TOKEN=

# ───────────── Opcionales ─────────────
# Zona horaria del negocio (horarios de atención y estadísticas).
STORE_TIME_ZONE=America/Argentina/Buenos_Aires
# Google Maps para elegir la ubicación del local en el backoffice.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# ───────────── Solo desarrollo local ─────────────
# Si se definen, se crea este administrador de prueba en la base local (PGlite).
DEV_ADMIN_EMAIL=
DEV_ADMIN_PASSWORD=
